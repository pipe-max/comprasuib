rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Autenticación y lista de correos autorizados ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Lista base de respaldo — la misma que ALLOWED_EMAILS_FALLBACK en app.js
    function isAllowedFallback() {
      return userEmail() in [
        'secretaria@theodoro.edu.co','comunicaciones@theodoro.edu.co','comunicaciones@uibmedellin.org',
        'gestionhumana@uibmedellin.org','gestionhumana@theodoro.edu.co','sistemagestion@theodoro.edu.co',
        'sistemas@theodoro.edu.co','coordinaciontransporte@theodoro.edu.co','mantenimiento@theodoro.edu.co',
        'soporte@theodoro.edu.co','enfermeria@theodoro.edu.co','camilo.correa@theodoro.edu.co',
        'deporteyextracurricular@theodoro.edu.co','coordinacionpreescolar@theodoro.edu.co',
        'coordinacionbachillerato@theodoro.edu.co','coordinacionprimaria@theodoro.edu.co',
        'administracion@theodoro.edu.co','ricardo.alvarez@theodoro.edu.co','secretaria@uibmedellin.org',
        'analistatesoreria@uibmedellin.org','analistacontable@theodoro.edu.co','contabilidad@uibmedellin.org',
        'pipe@theodoro.edu.co','direccionadministrativa@uibmedellin.org','rectoria@theodoro.edu.co',
        'riesgos@theodoro.edu.co','gerencia@uibmedellin.org','andresgonzalezcordoba@gmail.com'
      ];
    }

    // También acepta la lista dinámica que se administra en config/roles
    function isAllowed() {
      return isAuthenticated() && (
        isAllowedFallback() ||
        userEmail() in get(/databases/$(database)/documents/config/roles).data.get('allowed_emails', [])
      );
    }

    // Cada función de rol acepta la lista fija de respaldo O la lista dinámica
    // correspondiente en config/roles — así los cambios del panel de
    // Administración (que edita config/roles) sí revocan/otorgan acceso real,
    // no solo visibilidad en la interfaz.
    function isApprover() {
      return isAllowed() && (
        userEmail() in [
          'direccionadministrativa@uibmedellin.org',
          'rectoria@theodoro.edu.co',
          'gerencia@uibmedellin.org',
          'andresgonzalezcordoba@gmail.com',
          'contabilidad@uibmedellin.org',
          'pipe@theodoro.edu.co'
        ] ||
        userEmail() in get(/databases/$(database)/documents/config/roles).data.get('approval_emails', [])
      );
    }

    function canDelete() {
      return isAllowed() && (
        userEmail() in [
          'pipe@theodoro.edu.co',
          'direccionadministrativa@uibmedellin.org',
          'gerencia@uibmedellin.org',
          'analistatesoreria@uibmedellin.org',
          'analistacontable@theodoro.edu.co',
          'contabilidad@uibmedellin.org',
          'analistafinanciera@uibmedellin.org'
        ] ||
        userEmail() in get(/databases/$(database)/documents/config/roles).data.get('delete_emails', [])
      );
    }

    function isPaymentAuthorized() {
      return isAllowed() && (
        userEmail() in [
          'secretaria@uibmedellin.org',
          'analistatesoreria@uibmedellin.org',
          'analistacontable@theodoro.edu.co',
          'contabilidad@uibmedellin.org',
          'pipe@theodoro.edu.co'
        ] ||
        userEmail() in get(/databases/$(database)/documents/config/roles).data.get('payment_emails', [])
      );
    }

    function isOwner() {
      return resource.data.get('createdBy', '') == userEmail();
    }

    // El dueño de la orden (createdBy) no puede reasignarse en ningún update
    function unchangedOwnership() {
      return request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }

    // Los datos de aprobación (quién aprobó, firma, fecha) solo se pueden fijar
    // pasando por la rama de isApprover() de abajo — en cualquier otro update
    // deben quedar exactamente igual, así nadie forja una aprobación por fuera
    // del flujo formal
    function unchangedApprovalMetadata() {
      return request.resource.data.get('approvedBy', null) == resource.data.get('approvedBy', null) &&
        request.resource.data.get('approvedBySignature', null) == resource.data.get('approvedBySignature', null) &&
        request.resource.data.get('approvedDate', null) == resource.data.get('approvedDate', null);
    }

    // Acceso a Proveedores/Inventario — mismas listas y misma lógica que
    // ADMIN_SECTION_EMAILS / INVENTORY_ONLY_EMAILS / INVENTORY_PROVIDERS_EMAILS
    // en app.js, incluyendo la lista dinámica en config/roles
    function hasProvidersAccess() {
      return isAllowed() && (
        userEmail() in [
          'direccionadministrativa@uibmedellin.org','rectoria@theodoro.edu.co','gestionhumana@theodoro.edu.co',
          'gerencia@uibmedellin.org','secretaria@uibmedellin.org','mantenimiento@theodoro.edu.co',
          'analistatesoreria@uibmedellin.org','sistemas@theodoro.edu.co','analistacontable@theodoro.edu.co',
          'contabilidad@uibmedellin.org','comunicaciones@theodoro.edu.co','pipe@theodoro.edu.co'
        ] ||
        userEmail() in get(/databases/$(database)/documents/config/roles).data.get('admin_section_emails', []) ||
        userEmail() in get(/databases/$(database)/documents/config/roles).data.get('inventory_providers_emails', [])
      );
    }

    function hasInventoryAccess() {
      return hasProvidersAccess() || (
        isAllowed() && (
          userEmail() in ['sistemas@theodoro.edu.co', 'soporte@theodoro.edu.co'] ||
          userEmail() in get(/databases/$(database)/documents/config/roles).data.get('inventory_only_emails', [])
        )
      );
    }

    // ─── Órdenes ───
    match /orders/{orderId} {
      allow read: if isAllowed();
      allow create: if isAllowed();
      // Solo aprobadores pueden cambiar status a 'approved'
      // Solo autorizados pueden eliminar (deleted: true)
      // El resto de acciones (marcar pagos, adjuntar factura/comprobante, mover a
      // revisión, confirmar recibido a satisfacción, enviar al proveedor, editar
      // orden pendiente, etc.) solo las puede hacer contabilidad/tesorería, el
      // creador de la orden, o un super-admin. En ningún caso se puede
      // reasignar el dueño ni forjar los datos de aprobación por fuera del
      // flujo formal de isApprover()
      allow update: if isAllowed() && unchangedOwnership() && (
        (request.resource.data.status == 'approved' && isApprover()) ||
        (request.resource.data.get('deleted', false) == true && canDelete() && unchangedApprovalMetadata()) ||
        (
          request.resource.data.status != 'approved' &&
          request.resource.data.get('deleted', false) == false &&
          (isPaymentAuthorized() || canDelete() || isOwner()) &&
          unchangedApprovalMetadata()
        )
      );
      allow delete: if canDelete();
    }

    match /config/{docId} {
      allow read: if isAllowed();
      // Solo admins de usuarios pueden escribir en config/roles;
      // config/storageStats lo genera solo la Cloud Function (Admin SDK);
      // el catálogo de inventario solo lo edita quien tenga acceso a esa sección
      allow write: if isAllowed() &&
        docId != 'storageStats' &&
        (docId != 'roles' || userEmail() in ['gerencia@uibmedellin.org', 'pipe@theodoro.edu.co']) &&
        ((docId != 'customCategories' && docId != 'inventory' && !docId.matches('inventory_.*')) || hasInventoryAccess());
    }

    match /providers/{providerId} {
      allow read: if isAllowed();
      allow write: if hasProvidersAccess();
    }

    // Cada quien solo puede leer/escribir su propio token de notificaciones push
    match /fcmTokens/{email} {
      allow read, write: if isAllowed() && email == userEmail();
    }

    // No usado actualmente desde el cliente (la app no dispara notificaciones
    // push por esta vía) — solo la Cloud Function (Admin SDK) puede escribir
    match /notifications/{notifId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    match /rateLimits/{doc} {
      allow read, write: if false; // Solo Cloud Functions pueden escribir
    }

    match /clientErrors/{doc} {
      allow read, write: if false; // Solo Cloud Functions pueden escribir
    }
  }
}
